{
  "name": "Daily Goals Editor",
  "short_name": "Daily Goals",
  "description": "Plan the day's goals and copy them into Excel as one formatted cell.",
  "id": "./",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "any",
  "background_color": "#F3F4F6",
