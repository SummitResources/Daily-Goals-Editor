<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:ui="clr-namespace:Daily_Goals_Editor.UI"
             x:Class="Daily_Goals_Editor.MainPage"
             Title="Daily Goals Editor">

    <Grid RowDefinitions="52,*" BackgroundColor="{StaticResource AppBackground}">

        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Padding="20,0" 
              BackgroundColor="{StaticResource Surface}">
            <HorizontalStackLayout Spacing="10" VerticalOptions="Center">
                <Border WidthRequest="28" HeightRequest="28" StrokeThickness="0"
                        StrokeShape="RoundRectangle 8" BackgroundColor="{StaticResource Accent}">
                    <ui:Icon Kind="List" Size="16" Color="White"
                             HorizontalOptions="Center" VerticalOptions="Center" />
                </Border>
                <Label Text="Daily Goals Editor" FontSize="{DynamicResource TextSizeLarge}" FontAttributes="Bold" VerticalOptions="Center" />
            </HorizontalStackLayout>

            <HorizontalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                <Ellipse x:Name="SaveStateDot" WidthRequest="7" HeightRequest="7"
                         Fill="{StaticResource Success}" VerticalOptions="Center" />
                <Label x:Name="SaveStateLabel" Text="Saved locally" Style="{StaticResource Small}"
                       VerticalOptions="Center" />
                <BoxView WidthRequest="1" HeightRequest="18" Margin="10,0" VerticalOptions="Center"
                         Color="{StaticResource Line}" />
                <HorizontalStackLayout Spacing="2" VerticalOptions="Center">
                    <ui:UiButton x:Name="SmallerTextButton" Text="A−" Variant="Ghost" Compact="True"
                                 ToolTipProperties.Text="Smaller text" Clicked="OnSmallerText" />
                    <ui:UiButton x:Name="TextScaleButton" Variant="Ghost" Compact="True"
                                 ToolTipProperties.Text="Reset text size" Clicked="OnResetTextScale" />
                    <ui:UiButton x:Name="LargerTextButton" Text="A+" Variant="Ghost" Compact="True"
                                 ToolTipProperties.Text="Larger text" Clicked="OnLargerText" />
                </HorizontalStackLayout>
            </HorizontalStackLayout>
        </Grid>
        <BoxView Grid.Row="0" HeightRequest="1" VerticalOptions="End" Color="{StaticResource Line}" />

        <Grid Grid.Row="1" ColumnDefinitions="248,*,460">

            <Grid Grid.Column="0" RowDefinitions="Auto,Auto,*,Auto" RowSpacing="22" Padding="16,24"
                  BackgroundColor="{StaticResource SidebarBackground}">
                <VerticalStackLayout Spacing="4" Padding="6,0">
                    <Label Text="Today" Style="{StaticResource Eyebrow}" />
                    <Label x:Name="DateLabel" Style="{StaticResource H1}" />
                </VerticalStackLayout>

                <VerticalStackLayout x:Name="CategoryNav" Grid.Row="1" Spacing="2" />

                <VerticalStackLayout Grid.Row="3" Spacing="10">
                    <Border Style="{StaticResource Card}" Padding="14">
                        <VerticalStackLayout Spacing="10">
                            <Grid ColumnDefinitions="*,Auto">
                                <Label Text="Daily progress" Style="{StaticResource Small}" />
                                <Label x:Name="ProgressLabel" Grid.Column="1" FontSize="{DynamicResource TextSizeSmall}" FontAttributes="Bold" />
                            </Grid>
                            <Grid x:Name="ProgressTrack" HeightRequest="6">
                                <Border StrokeThickness="0" StrokeShape="RoundRectangle 3"
                                        BackgroundColor="{StaticResource Line}" />
                                <Border x:Name="ProgressFill" StrokeThickness="0" StrokeShape="RoundRectangle 3"
                                        BackgroundColor="{StaticResource Accent}"
                                        HorizontalOptions="Start" WidthRequest="0" />
                            </Grid>
                        </VerticalStackLayout>
                    </Border>
                    <ui:UiButton Text="Start A New Day" Variant="Ghost" Compact="True"
                                 HorizontalOptions="Start" Clicked="OnStartNewDay" />
                </VerticalStackLayout>
            </Grid>
            <BoxView Grid.Column="0" WidthRequest="1" HorizontalOptions="End" Color="{StaticResource Line}" />

            <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" RowSpacing="16" Padding="28,24,28,0">
                <Grid ColumnDefinitions="*,Auto">
                    <VerticalStackLayout Spacing="4">
                        <Label Text="Plan your day" Style="{StaticResource Eyebrow}" />
                        <Label x:Name="ColumnTitle" Style="{StaticResource H2}" />
                    </VerticalStackLayout>
                    <ui:UiButton Grid.Column="1" Text="Add task" Icon="Plus" Variant="Primary"
                                 VerticalOptions="End" Clicked="OnAddTask" />
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource Card}" Padding="16">
                    <VerticalStackLayout Spacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label x:Name="PromptLabel" FontSize="{DynamicResource TextSizeLarge}" FontAttributes="Bold" />
                            <Label x:Name="HintLabel" Style="{StaticResource Small}" />
                        </VerticalStackLayout>
                        <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                            <Border Style="{StaticResource Input}">
                                <Entry x:Name="PromptEntry" Placeholder="Type here and press Enter"
                                       ReturnType="Next" Completed="OnSubmitPrompt" />
                            </Border>
                            <ui:UiButton Grid.Column="1" Text="Add" Variant="Primary"
                                         VerticalOptions="Center" Clicked="OnSubmitPrompt" />
                            <ui:UiButton x:Name="DoneButton" Grid.Column="2" Text="Done" Icon="Check"
                                         Variant="Secondary" VerticalOptions="Center" Clicked="OnDone" />
                        </Grid>
                        <Label x:Name="StatusLabel" FontSize="{DynamicResource TextSizeSmall}" IsVisible="False"
                               TextColor="{StaticResource Accent}" />
                    </VerticalStackLayout>
                </Border>

                <ScrollView Grid.Row="2">
                    <VerticalStackLayout x:Name="TaskList" Spacing="8" Padding="0,0,0,24" />
                </ScrollView>
            </Grid>

            <Grid Grid.Column="2" RowDefinitions="*,Auto" BackgroundColor="{StaticResource Surface}">
                <ScrollView Grid.Row="0">
                    <VerticalStackLayout x:Name="EditorHost" Padding="24,20" Spacing="20" />
                </ScrollView>

                <Border Grid.Row="1" Margin="24,0,24,24" Padding="16" Style="{StaticResource Card}"
                        BackgroundColor="{StaticResource CodeBackground}">
                    <VerticalStackLayout Spacing="10">
                        <Grid ColumnDefinitions="*,Auto">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="Excel-ready list" Style="{StaticResource SectionTitle}" />
                                <Label Text="Formatted for a single cell" Style="{StaticResource Small}" />
                            </VerticalStackLayout>
                            <ui:UiButton x:Name="CopyButton" Grid.Column="1" Text="Copy" Icon="Copy"
                                         Variant="Secondary" Compact="True" VerticalOptions="Center"
                                         Clicked="OnCopy" />
                        </Grid>
                        <ScrollView MaximumHeightRequest="220">
                            <Label x:Name="OutputLabel" Style="{StaticResource Mono}" FontSize="{DynamicResource TextSizeSmall}" LineHeight="1.3" />
                        </ScrollView>
                        <Label Text="Paste directly into Excel. Line breaks and indentation are preserved."
                               Style="{StaticResource Small}" />
                    </VerticalStackLayout>
                </Border>

                <BoxView Grid.RowSpan="2" WidthRequest="1" HorizontalOptions="Start" Color="{StaticResource Line}" />
            </Grid>
        </Grid>
    </Grid>
</ContentPage>
