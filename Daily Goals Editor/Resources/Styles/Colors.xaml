<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<!-- Only the category colors come from the Figma file; the neutrals and accent were chosen to fit it
     because the design's stylesheet wasn't available. -->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <Color x:Key="AppBackground">#F3F4F6</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="SidebarBackground">#F9FAFB</Color>
    <Color x:Key="CodeBackground">#F9FAFB</Color>
    <Color x:Key="Hover">#F1F2F5</Color>
    <Color x:Key="Chip">#F1F2F5</Color>

    <Color x:Key="Line">#E5E7EB</Color>
    <Color x:Key="LineStrong">#D1D5DB</Color>

    <Color x:Key="Ink">#111827</Color>
    <Color x:Key="InkSoft">#374151</Color>
    <Color x:Key="Muted">#6B7280</Color>
    <Color x:Key="Subtle">#9CA3AF</Color>

    <Color x:Key="Accent">#4F46E5</Color>
    <Color x:Key="AccentHover">#4338CA</Color>
    <Color x:Key="AccentTint">#EEF2FF</Color>
    <Color x:Key="Success">#0F8A72</Color>
    <Color x:Key="SuccessTint">#E6F5F1</Color>
    <Color x:Key="Danger">#DC2626</Color>
    <Color x:Key="DangerTint">#FEF2F2</Color>

    <Color x:Key="CategoryProduct">#7C3AED</Color>
    <Color x:Key="CategoryEngineering">#2563EB</Color>
    <Color x:Key="CategoryDesign">#DB2777</Color>
    <Color x:Key="CategoryOperations">#0F8A72</Color>

</ResourceDictionary>
